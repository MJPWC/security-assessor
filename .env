# Security Assessor local configuration template.
# Put real secrets in .env.local, .envlocal, or .env.private, not in this file.

SECURITY_ASSESSOR_PORT=5050

# Optional Python dependency vulnerability service for pip-audit: pypi or osv.
PIP_AUDIT_SERVICE=pypi

# Shared LLM configuration used by security and quality assessment.
# Supported LLM_PROVIDER values: anthropic, groq, openai, gemini, openrouter
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_VERSION=2023-06-01

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
